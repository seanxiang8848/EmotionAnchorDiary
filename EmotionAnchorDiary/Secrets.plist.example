<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  使用说明：
  1. 把本文件重命名为 Secrets.plist
  2. 填入 AI 服务的 HTTPS 地址
  3. 在 Xcode 中把 Secrets.plist 加入 EmotionAnchorDiary target
  4. API Key 在应用设置里输入并存入本机 Keychain，不要写入此文件
-->
<plist version="1.0">
<dict>
	<key>AIEndpoint</key>
	<string>https://your-ai-endpoint.example.com/v1/empathy</string>
</dict>
</plist>
